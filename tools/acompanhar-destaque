#!/usr/bin/env bash
# plasma-w11: faz o painel, a bandeja e o menu Iniciar trocarem de cor na hora
# quando a cor de destaque muda (pelas Configurações ou pelo papel de parede).
#
# Quem troca a cor grava o kdeglobals em etapas e avisa (KGlobalSettings.notifyChange)
# no meio delas; o plasmashell redesenha com o que leu naquele instante e fica com a
# cor anterior. Aqui esperamos a gravação terminar e repetimos o aviso.
set -u

now_ms() { date +%s%3N; }
ignore_until=0

# Apps em widgets (Dolphin, Configurações) usam a cor do Kvantum, que é fixa no tema:
# mantemos uma cópia do Windows-modern ("Windows-11") com a cor de destaque no lugar do azul.
# O Kvantum só lê o tema ao abrir o app, então eles mudam quando forem abertos de novo.
KV="${XDG_CONFIG_HOME:-$HOME/.config}/Kvantum"
sync_kvantum() {
    local src="$KV/Windows-modern" dst="$KV/Windows-11" rgb hex transp
    [ -d "$src" ] || return 0
    rgb=$(kreadconfig6 --file kdeglobals --group General --key AccentColor)
    [ -n "$rgb" ] && hex=$(printf '#%02X%02X%02X' ${rgb//,/ }) || hex="#4CC2FF"
    # "Efeitos de transparência" (Configurações › Personalização › Cores): ligado = janelas
    # translúcidas, num tom que sobre papel de parede escuro dá o #202020 do Windows;
    # desligado = sólidas em #202020
    transp=$(kreadconfig6 --file plasma-w11rc --group Aparencia --key Transparencia --default true)
    [ "$(cat "$dst/.destaque" 2>/dev/null)" = "$hex $transp" ] && return 0
    mkdir -p "$dst"
    for v in Dark ""; do
        local blue; [ -n "$v" ] && blue="#4CC2FF" || blue="#0067C0"
        sed -e "s/$blue/$hex/Ig" \
            -e "s/^translucent_windows=.*/translucent_windows=$transp/" \
            -e "s/^blurring=.*/blurring=$transp/" \
            "$src/Windows-modern$v.kvconfig" > "$dst/Windows-11$v.kvconfig"
        # sem transparência, o fundo das janelas fica sólido (o tema desenha com opacidade 0,8)
        local glass
        if [ "$transp" = true ]; then
            # o tema original (#202020 a 80%) fica quase preto sobre papel de parede escuro
            glass='/id="window-/{s/fill="#202020"/fill="#2B2B2B"/;s/opacity="[.0-9]*"/opacity=".85"/}'
        else
            glass='/id="window-/s/opacity="[.0-9]*"/opacity="1"/'
        fi
        sed -e "s/$blue/$hex/Ig" -e "$glass" "$src/Windows-modern$v.svg" > "$dst/Windows-11$v.svg"
    done
    echo "$hex $transp" > "$dst/.destaque"
    [ "$(kreadconfig6 --file "$KV/kvantum.kvconfig" --group General --key theme)" = Windows-11 ] \
        || kwriteconfig6 --file "$KV/kvantum.kvconfig" --group General --key theme Windows-11
}

# "acompanhar-destaque --agora": só atualiza o tema (usado pela página Cores) e sai
if [ "${1:-}" = --agora ]; then
    sync_kvantum
    exit 0
fi
sync_kvantum

dbus-monitor --session "type='signal',interface='org.kde.KGlobalSettings',member='notifyChange'" 2>/dev/null |
while read -r line; do
    case $line in
        *member=notifyChange*) ;;
        *) continue ;;
    esac
    # o eco do nosso próprio aviso
    [ "$(now_ms)" -lt "$ignore_until" ] && continue
    # espera os avisos (e a gravação) pararem
    while read -r -t 1 _; do :; done
    ignore_until=$(( $(now_ms) + 1500 ))
    dbus-send --session --type=signal /KGlobalSettings org.kde.KGlobalSettings.notifyChange int32:0 int32:0
    sync_kvantum
done

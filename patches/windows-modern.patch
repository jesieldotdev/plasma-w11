diff --git a/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/ToggleSwitch.qml b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/ToggleSwitch.qml
new file mode 100644
index 0000000..2e90dff
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/ToggleSwitch.qml
@@ -0,0 +1,44 @@
+import QtQuick
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.components as PlasmaComponents3
+
+// Chave no estilo do Windows 11: pílula de 40x20; desligada, só o contorno e
+// a bolinha; ligada, cheia na cor de destaque com a bolinha escura. A bolinha
+// cresce no hover e estica ao pressionar, como no Windows.
+PlasmaComponents3.Switch {
+    id: control
+
+    text: ""
+    spacing: 0
+    padding: 0
+
+    indicator: Rectangle {
+        implicitWidth: 40
+        implicitHeight: 20
+        x: control.leftPadding
+        y: control.topPadding + control.availableHeight / 2 - height / 2
+        radius: height / 2
+        color: control.checked
+            ? (control.hovered ? Qt.lighter(Kirigami.Theme.highlightColor, 1.1) : Kirigami.Theme.highlightColor)
+            : (control.hovered ? Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.06) : "transparent")
+        border.width: control.checked ? 0 : 1
+        border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.65)
+        opacity: control.enabled ? 1 : 0.4
+        Behavior on color { ColorAnimation { duration: 100 } }
+
+        Rectangle {
+            readonly property real size: control.hovered ? 14 : 12
+            width: control.pressed ? size + 3 : size
+            height: size
+            radius: height / 2
+            anchors.verticalCenter: parent.verticalCenter
+            x: control.checked ? parent.width - width - 4 : 4
+            color: control.checked ? Kirigami.Theme.backgroundColor : Kirigami.Theme.textColor
+            Behavior on x { NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }
+            Behavior on width { NumberAnimation { duration: 100 } }
+            Behavior on height { NumberAnimation { duration: 100 } }
+        }
+    }
+
+    contentItem: Item {}
+}
diff --git a/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/WinButton.qml b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/WinButton.qml
new file mode 100644
index 0000000..b94a49e
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/lib/WinButton.qml
@@ -0,0 +1,60 @@
+import QtQuick
+import org.kde.kirigami as Kirigami
+import org.kde.plasma.components as PlasmaComponents3
+
+// Botão do Windows 11: normal (cinza translúcido com borda fina) ou de
+// destaque (cor de destaque, texto escuro ou claro conforme o contraste).
+Rectangle {
+    id: button
+
+    property string text
+    property string iconName: ""
+    property bool primary: false
+    signal clicked
+
+    readonly property color accentText: Kirigami.ColorUtils.brightnessForColor(Kirigami.Theme.highlightColor) === Kirigami.ColorUtils.Light
+        ? "#000000" : "#ffffff"
+
+    implicitWidth: Math.max(96, row.implicitWidth + 24)
+    implicitHeight: 32
+    radius: 4
+    opacity: enabled ? 1 : 0.45
+    color: primary
+        ? (ma.containsPress ? Qt.darker(Kirigami.Theme.highlightColor, 1.15)
+           : ma.containsMouse ? Qt.lighter(Kirigami.Theme.highlightColor, 1.08) : Kirigami.Theme.highlightColor)
+        : Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b,
+                  ma.containsPress ? 0.04 : (ma.containsMouse ? 0.09 : 0.06))
+    border.width: primary ? 0 : 1
+    border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.08)
+    Behavior on color { ColorAnimation { duration: 90 } }
+
+    Row {
+        id: row
+        anchors.centerIn: parent
+        spacing: 6
+        Kirigami.Icon {
+            visible: button.iconName !== ""
+            anchors.verticalCenter: parent.verticalCenter
+            width: 16
+            height: 16
+            source: button.iconName
+            isMask: true
+            color: button.primary ? button.accentText : Kirigami.Theme.textColor
+        }
+        PlasmaComponents3.Label {
+            anchors.verticalCenter: parent.verticalCenter
+            text: button.text
+            color: button.primary ? button.accentText : Kirigami.Theme.textColor
+            opacity: button.primary || ma.containsPress === false ? 1 : 0.8
+        }
+    }
+
+    MouseArea {
+        id: ma
+        anchors.fill: parent
+        hoverEnabled: true
+        enabled: button.enabled
+        cursorShape: Qt.PointingHandCursor
+        onClicked: button.clicked()
+    }
+}

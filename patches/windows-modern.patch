diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/code/program-location.sh b/plasma/applets/org.kde.windowsmodern.startmenu/contents/code/program-location.sh
new file mode 100755
index 0000000..228c0f0
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/code/program-location.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+# Abre no Dolphin onde está o programa de um atalho .desktop
+# ("Abrir local do programa" no menu Iniciar).
+#   Flatpak  -> pasta do app em .../flatpak/app/<id>
+#   Snap     -> /var/lib/snapd/snap/<nome> (ou /snap/<nome>)
+#   o resto  -> o executável (AppImage, script, binário) selecionado
+desktop=$1
+[ -f "$desktop" ] || exit 1
+
+key() { sed -n "/^\[Desktop Entry\]/,/^\[/{s/^$1=//p}" "$desktop" | head -n1; }
+open_dir() { exec dolphin --new-window "$1"; }
+select_file() { exec dolphin --new-window --select "$1"; }
+
+flatpak_id=$(key X-Flatpak)
+if [ -n "$flatpak_id" ]; then
+    for d in "$HOME/.local/share/flatpak/app/$flatpak_id" "/var/lib/flatpak/app/$flatpak_id"; do
+        [ -d "$d" ] && open_dir "$d"
+    done
+fi
+
+snap=$(key X-SnapInstanceName)
+exec_line=$(key Exec)
+if [ -z "$snap" ]; then
+    case $exec_line in */snap/bin/*|snap\ run*) snap=$(printf '%s\n' "$exec_line" | sed -E 's#.*/snap/bin/([^ ]+).*#\1#; s#^snap run ([^ ]+).*#\1#') ;; esac
+fi
+if [ -n "$snap" ]; then
+    snap=${snap%%.*}
+    for d in "/var/lib/snapd/snap/$snap" "/snap/$snap"; do
+        [ -d "$d" ] && open_dir "$d"
+    done
+fi
+
+# primeira "palavra" do Exec, sem "env VAR=..." e sem aspas (xargs separa
+# respeitando as aspas sem executar nada do que estiver na linha)
+mapfile -t words < <(printf '%s\n' "$exec_line" | xargs -n1 printf '%s\n' 2>/dev/null)
+[ ${#words[@]} -gt 0 ] || read -ra words <<< "$exec_line"
+i=0
+[ "${words[0]}" = env ] && i=1
+while [ $i -lt ${#words[@]} ] && [[ ${words[$i]} == *=* ]]; do i=$((i + 1)); done
+prog=${words[$i]}
+[ -n "$prog" ] || select_file "$desktop"
+case $prog in
+    /*) path=$prog ;;
+    *)  path=$(command -v -- "$prog") ;;
+esac
+if [ -n "$path" ] && [ -e "$path" ]; then
+    # segue links (ex.: /usr/bin/app -> /opt/App/app) até o arquivo de verdade
+    select_file "$(readlink -f -- "$path")"
+fi
+select_file "$desktop"

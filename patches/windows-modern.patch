diff --git a/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/components/ProjectPage.qml b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/components/ProjectPage.qml
new file mode 100644
index 0000000..ff08477
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.systemtray/contents/ui/components/ProjectPage.qml
@@ -0,0 +1,130 @@
+/*
+    Projetar, como no Windows 11 (Win+P): Somente tela do PC, Duplicar,
+    Estender e Somente segunda tela. Quem aplica é o "projetar" do plasma-w11
+    (kscreen-doctor por baixo).
+*/
+import QtQuick
+import QtQuick.Layouts
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.plasma.plasma5support as Plasma5Support
+import org.kde.kirigami as Kirigami
+import "../lib" as Lib
+
+Lib.Page {
+    id: page
+
+    title: i18n("Project")
+    contentFillsHeight: false
+
+    property string mode: ""
+    readonly property string tool: "\"$HOME/.local/bin/projetar\""
+
+    function refresh() {
+        runner.run(tool + " estado");
+    }
+
+    Plasma5Support.DataSource {
+        id: runner
+        engine: "executable"
+        connectedSources: []
+        onNewData: function (sourceName, data) {
+            if (sourceName.endsWith(" estado")) {
+                page.mode = (data["stdout"] || "").trim();
+            } else {
+                // depois de aplicar, o KScreen leva um instante para assentar
+                refreshLater.restart();
+            }
+            disconnectSource(sourceName);
+        }
+        function run(cmd) {
+            connectSource(cmd);
+        }
+    }
+    Timer { id: refreshLater; interval: 800; onTriggered: page.refresh() }
+
+    onVisibleChanged: if (visible) refresh()
+    Component.onCompleted: refresh()
+
+    PlasmaComponents3.Label {
+        visible: page.mode === "uma"
+        Layout.fillWidth: true
+        Layout.leftMargin: 18
+        Layout.rightMargin: 18
+        Layout.bottomMargin: 8
+        wrapMode: Text.Wrap
+        opacity: 0.7
+        text: i18n("Connect a second display to choose how to use it.")
+    }
+
+    // Coluna de tiles grandes, como no Windows: o modo atual fica na cor de destaque
+    ColumnLayout {
+        Layout.fillWidth: true
+        Layout.leftMargin: 14
+        Layout.rightMargin: 14
+        spacing: 6
+
+        Repeater {
+            model: [
+                { id: "pc",       text: i18n("PC screen only"),     icon: "w11-project-pc",        fallback: "computer-laptop-symbolic" },
+                { id: "duplicar", text: i18n("Duplicate"),          icon: "w11-project-duplicate", fallback: "edit-copy-symbolic" },
+                { id: "estender", text: i18n("Extend"),             icon: "w11-project-extend",    fallback: "monitor-symbolic" },
+                { id: "segunda",  text: i18n("Second screen only"), icon: "w11-project-second",    fallback: "monitor-symbolic" }
+            ]
+            delegate: Rectangle {
+                id: modeTile
+                required property var modelData
+                readonly property bool selected: page.mode === modelData.id
+                readonly property bool usable: page.mode !== "uma"
+                readonly property color ink: selected ? (Kirigami.ColorUtils.brightnessForColor(Kirigami.Theme.highlightColor) === Kirigami.ColorUtils.Light ? "#1E1E1E" : "#FFFFFF")
+                                                      : Kirigami.Theme.textColor
+
+                Layout.fillWidth: true
+                Layout.preferredHeight: 60
+                radius: 6
+                opacity: usable ? 1 : 0.45
+                color: selected
+                       ? (tileMouse.containsPress ? Qt.darker(Kirigami.Theme.highlightColor, 1.12)
+                          : tileMouse.containsMouse ? Qt.lighter(Kirigami.Theme.highlightColor, 1.08) : Kirigami.Theme.highlightColor)
+                       : Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b,
+                                 tileMouse.containsPress ? 0.035 : (tileMouse.containsMouse ? 0.085 : 0.06))
+                border.width: selected ? 0 : 1
+                border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.08)
+                Behavior on color { ColorAnimation { duration: 120 } }
+
+                RowLayout {
+                    anchors.fill: parent
+                    anchors.leftMargin: 16
+                    anchors.rightMargin: 16
+                    spacing: 16
+                    Kirigami.Icon {
+                        Layout.preferredWidth: 32
+                        Layout.preferredHeight: 32
+                        source: modeTile.modelData.icon
+                        fallback: modeTile.modelData.fallback
+                        color: modeTile.ink
+                        isMask: true
+                    }
+                    PlasmaComponents3.Label {
+                        Layout.fillWidth: true
+                        text: modeTile.modelData.text
+                        color: modeTile.ink
+                        elide: Text.ElideRight
+                    }
+                }
+                MouseArea {
+                    id: tileMouse
+                    anchors.fill: parent
+                    enabled: modeTile.usable
+                    hoverEnabled: true
+                    cursorShape: Qt.PointingHandCursor
+                    onClicked: {
+                        page.mode = modeTile.modelData.id;
+                        runner.run(page.tool + " " + modeTile.modelData.id);
+                    }
+                }
+            }
+        }
+    }
+
+    Item { Layout.preferredHeight: 8 }
+}

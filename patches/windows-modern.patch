diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/CategoryTile.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/CategoryTile.qml
new file mode 100644
index 0000000..d47d3a2
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/CategoryTile.qml
@@ -0,0 +1,141 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   "Pasta" de categoria da vista Categoria do Iniciar do Windows 11:
+ *   quadro arredondado com 2x2 ícones e o nome embaixo.  Os três primeiros
+ *   ícones abrem o app direto; o quarto canto mostra mais quatro ícones
+ *   pequenos quando a categoria tem mais apps.  O resto do quadro abre a
+ *   categoria.
+ ***************************************************************************/
+
+import QtQuick
+
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+Item {
+    id: tile
+
+    required property var modelData
+    required property int index
+
+    signal openRequested
+
+    width: GridView.view.cellWidth
+    height: GridView.view.cellHeight
+
+    readonly property bool focused: GridView.isCurrentItem && GridView.view.activeFocus
+    readonly property bool overflow: modelData.count > 4
+    readonly property real boxSize: width - Kirigami.Units.largeSpacing * 2
+    // 2x2 ícones de 32 px, com pouco respiro, como as pastas do Windows
+    readonly property real slot: Kirigami.Units.iconSizes.medium + Kirigami.Units.smallSpacing * 2
+
+    Accessible.role: Accessible.Button
+    Accessible.name: modelData.name
+
+    Rectangle {
+        id: box
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: Kirigami.Units.smallSpacing
+        width: tile.boxSize
+        height: Math.round(tile.boxSize * 0.8)
+        radius: Kirigami.Units.smallSpacing * 2
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b,
+                       boxMouse.containsMouse ? 0.10 : 0.05)
+        border.width: tile.focused ? 2 : 1
+        border.color: tile.focused ? Kirigami.Theme.textColor
+                                   : Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.06)
+        Behavior on color { ColorAnimation { duration: 90 } }
+
+        MouseArea {
+            id: boxMouse
+            anchors.fill: parent
+            hoverEnabled: true
+            onClicked: tile.openRequested()
+        }
+
+        Grid {
+            anchors.centerIn: parent
+            columns: 2
+            columnSpacing: Kirigami.Units.smallSpacing * 2
+            rowSpacing: Kirigami.Units.smallSpacing * 2
+
+            Repeater {
+                model: 4
+                delegate: Item {
+                    id: cell
+                    required property int index
+                    readonly property bool mini: index === 3 && tile.overflow
+                    readonly property var app: !mini && index < tile.modelData.apps.length ? tile.modelData.apps[index] : null
+                    width: tile.slot
+                    height: tile.slot
+
+                    // ícone grande: abre o app
+                    Rectangle {
+                        visible: cell.app !== null
+                        anchors.fill: parent
+                        anchors.margins: -Kirigami.Units.smallSpacing
+                        radius: Kirigami.Units.smallSpacing
+                        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.10)
+                        opacity: appMouse.containsMouse ? 1 : 0
+                    }
+                    Kirigami.Icon {
+                        visible: cell.app !== null
+                        anchors.centerIn: parent
+                        width: Math.min(parent.width, Kirigami.Units.iconSizes.medium)
+                        height: width
+                        animated: false
+                        source: cell.app ? cell.app.icon : ""
+                        scale: appMouse.pressed ? 0.88 : 1
+                        Behavior on scale { NumberAnimation { duration: 90 } }
+                    }
+                    MouseArea {
+                        id: appMouse
+                        visible: cell.app !== null
+                        anchors.fill: parent
+                        hoverEnabled: true
+                        PlasmaComponents3.ToolTip.text: cell.app ? cell.app.name : ""
+                        PlasmaComponents3.ToolTip.visible: containsMouse
+                        PlasmaComponents3.ToolTip.delay: Kirigami.Units.toolTipDelay
+                        onClicked: {
+                            tile.modelData.model.trigger(cell.app.row, "", null);
+                            root.closeMenu();
+                        }
+                    }
+
+                    // canto com 2x2 ícones pequenos: abre a categoria
+                    Grid {
+                        visible: cell.mini
+                        anchors.centerIn: parent
+                        columns: 2
+                        spacing: Kirigami.Units.smallSpacing / 2
+                        Repeater {
+                            model: cell.mini ? tile.modelData.apps.slice(3, 7) : []
+                            delegate: Kirigami.Icon {
+                                required property var modelData
+                                width: Math.round(Kirigami.Units.iconSizes.medium / 2) - 1
+                                height: width
+                                animated: false
+                                source: modelData.icon
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    PlasmaComponents3.Label {
+        anchors.top: box.bottom
+        anchors.topMargin: Kirigami.Units.smallSpacing
+        anchors.left: box.left
+        anchors.right: box.right
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+        maximumLineCount: 1
+        font.pointSize: Kirigami.Theme.defaultFont.pointSize - 1
+        color: Kirigami.Theme.textColor
+        text: tile.modelData.name
+    }
+}
diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/RecommendedItem.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/RecommendedItem.qml
new file mode 100644
index 0000000..ebcf5d3
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/RecommendedItem.qml
@@ -0,0 +1,114 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Item da seção Recomendado do Iniciar do Windows 11: ícone à esquerda,
+ *   nome e uma linha de detalhe em cinza.  Mesmo clique/menu do AppTile.
+ ***************************************************************************/
+
+import QtQuick
+
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+import "../code/tools.js" as Tools
+
+Item {
+    id: item
+
+    width: GridView.view.cellWidth
+    height: GridView.view.cellHeight
+
+    property int itemIndex: model.index
+
+    Accessible.role: Accessible.MenuItem
+    Accessible.name: nameLabel.text
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.smallSpacing / 2
+        radius: Kirigami.Units.smallSpacing
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g,
+                       Kirigami.Theme.textColor.b, mouseArea.pressed ? 0.04 : 0.07)
+        border.width: item.GridView.isCurrentItem && item.GridView.view.activeFocus ? 2 : 0
+        border.color: Kirigami.Theme.textColor
+        opacity: mouseArea.containsMouse || (item.GridView.isCurrentItem && item.GridView.view.activeFocus) ? 1 : 0
+        Behavior on opacity { NumberAnimation { duration: 90 } }
+    }
+
+    Kirigami.Icon {
+        id: icon
+        anchors.left: parent.left
+        anchors.leftMargin: Kirigami.Units.largeSpacing * 1.5
+        anchors.verticalCenter: parent.verticalCenter
+        width: Kirigami.Units.iconSizes.medium
+        height: width
+        animated: false
+        source: model.decoration !== undefined ? model.decoration : ""
+    }
+
+    Column {
+        anchors.left: icon.right
+        anchors.leftMargin: Kirigami.Units.largeSpacing * 1.5
+        anchors.right: parent.right
+        anchors.rightMargin: Kirigami.Units.largeSpacing
+        anchors.verticalCenter: parent.verticalCenter
+        spacing: 0
+
+        PlasmaComponents3.Label {
+            id: nameLabel
+            width: parent.width
+            elide: Text.ElideRight
+            maximumLineCount: 1
+            textFormat: Text.PlainText
+            color: Kirigami.Theme.textColor
+            text: model.display !== undefined ? model.display : ""
+        }
+        PlasmaComponents3.Label {
+            width: parent.width
+            visible: text !== ""
+            elide: Text.ElideMiddle
+            maximumLineCount: 1
+            textFormat: Text.PlainText
+            font.pointSize: Kirigami.Theme.defaultFont.pointSize - 1
+            color: Kirigami.Theme.disabledTextColor
+            text: model.description !== undefined && model.description !== model.display ? model.description : ""
+        }
+    }
+
+    MouseArea {
+        id: mouseArea
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        onClicked: mouse => {
+            if (mouse.button === Qt.RightButton) {
+                item.openContextMenu(mouse.x, mouse.y);
+            } else {
+                item.launch();
+            }
+        }
+    }
+
+    function launch() {
+        var view = item.GridView.view;
+        if (view && view.model) {
+            view.model.trigger(item.itemIndex, "", null);
+            root.closeMenu();
+        }
+    }
+
+    function openContextMenu(localX, localY) {
+        var acts = model.actionList !== undefined && model.actionList ? model.actionList.slice() : [];
+        if (acts.length === 0) return;
+        var view = item.GridView.view;
+        var pos = item.mapToItem(sharedContextMenu, localX, localY);
+        sharedContextMenu.open(acts, pos.x, pos.y, { model: view ? view.model : null, index: item.itemIndex });
+    }
+
+    Keys.onPressed: event => {
+        if (event.key === Qt.Key_Enter || event.key === Qt.Key_Return) {
+            event.accepted = true;
+            launch();
+        }
+    }
+}
diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SearchBar.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SearchBar.qml
new file mode 100644
index 0000000..0b74384
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SearchBar.qml
@@ -0,0 +1,83 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Caixa de pesquisa no topo do Iniciar do Windows 11: arredondada,
+ *   lupa à esquerda, linha de destaque embaixo quando tem foco.
+ ***************************************************************************/
+
+import QtQuick
+
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+import "../code/theme.js" as Theme
+
+PlasmaComponents3.TextField {
+    id: field
+
+    signal searchFocusResults
+    signal searchNavUp
+    signal searchNavDown
+    signal searchActivateFirstResult
+    signal searchEscapePressed
+
+    function focusSearch() {
+        forceActiveFocus();
+    }
+
+    focus: true
+    placeholderText: i18n("Search for apps, settings, and documents")
+    topPadding: Math.round(Kirigami.Units.gridUnit * 0.55)
+    bottomPadding: topPadding
+    leftPadding: Kirigami.Units.iconSizes.small + Kirigami.Units.largeSpacing * 2
+    rightPadding: Kirigami.Units.largeSpacing
+    font.pointSize: Kirigami.Theme.defaultFont.pointSize
+
+    background: Rectangle {
+        radius: height / 2
+        color: Qt.rgba(Kirigami.Theme.backgroundColor.r, Kirigami.Theme.backgroundColor.g,
+                       Kirigami.Theme.backgroundColor.b, field.activeFocus ? 0.95 : 0.7)
+        border.width: 1
+        border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g,
+                              Kirigami.Theme.textColor.b, Theme.fieldBorderOpacity)
+
+        // destaque de foco na borda de baixo, como os campos do Windows 11
+        Rectangle {
+            anchors.bottom: parent.bottom
+            anchors.horizontalCenter: parent.horizontalCenter
+            width: parent.width - parent.radius * 2
+            height: 2
+            radius: 1
+            color: Kirigami.Theme.highlightColor
+            opacity: field.activeFocus ? 1 : 0
+            Behavior on opacity { NumberAnimation { duration: 120 } }
+        }
+    }
+
+    Kirigami.Icon {
+        source: "search"
+        anchors.left: parent.left
+        anchors.leftMargin: Kirigami.Units.largeSpacing
+        anchors.verticalCenter: parent.verticalCenter
+        width: Kirigami.Units.iconSizes.small
+        height: width
+    }
+
+    Keys.onPressed: event => {
+        if (event.key === Qt.Key_Escape) {
+            event.accepted = true;
+            searchEscapePressed();
+        } else if (event.key === Qt.Key_Down) {
+            event.accepted = true;
+            searchNavDown();
+        } else if (event.key === Qt.Key_Up) {
+            event.accepted = true;
+            searchNavUp();
+        } else if (event.key === Qt.Key_Tab) {
+            event.accepted = true;
+            searchFocusResults();
+        }
+    }
+    Keys.onReturnPressed: searchActivateFirstResult()
+    Keys.onEnterPressed: searchActivateFirstResult()
+}
diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SectionHeader.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SectionHeader.qml
new file mode 100644
index 0000000..dae92fb
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/SectionHeader.qml
@@ -0,0 +1,95 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Cabeçalho de seção do Iniciar ("Fixado", "Todos", nome da categoria):
+ *   título em negrito à esquerda e um botão discreto à direita
+ *   ("Mostrar tudo >", "Categoria v") ou "<" de voltar antes do título.
+ ***************************************************************************/
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+RowLayout {
+    id: header
+
+    property string title
+    property string buttonText
+    property string buttonIcon: "go-next"
+    property bool backButton: false
+
+    signal buttonClicked(Item button)
+    signal backClicked
+
+    Layout.fillWidth: true
+    Layout.leftMargin: Kirigami.Units.largeSpacing
+    Layout.rightMargin: Kirigami.Units.smallSpacing
+    Layout.preferredHeight: Math.round(Kirigami.Units.gridUnit * 1.8)
+    spacing: Kirigami.Units.smallSpacing
+
+    HeaderButton {
+        visible: header.backButton
+        iconName: "go-previous"
+        onClicked: header.backClicked()
+    }
+
+    PlasmaComponents3.Label {
+        text: header.title
+        font.weight: Font.DemiBold
+        color: Kirigami.Theme.textColor
+        elide: Text.ElideRight
+        Layout.fillWidth: true
+    }
+
+    HeaderButton {
+        id: button
+        visible: header.buttonText !== ""
+        text: header.buttonText
+        iconName: header.buttonIcon
+        onClicked: header.buttonClicked(button)
+    }
+
+    component HeaderButton: Rectangle {
+        id: btn
+        property string text
+        property string iconName
+        signal clicked
+
+        implicitWidth: btnRow.implicitWidth + Kirigami.Units.largeSpacing * (text === "" ? 1 : 2)
+        implicitHeight: Math.round(Kirigami.Units.gridUnit * 1.5)
+        radius: Kirigami.Units.smallSpacing
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b,
+                       btnMouse.pressed ? 0.04 : (btnMouse.containsMouse ? 0.10 : 0.06))
+        border.width: 1
+        border.color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.08)
+
+        Row {
+            id: btnRow
+            anchors.centerIn: parent
+            spacing: Kirigami.Units.smallSpacing
+            PlasmaComponents3.Label {
+                visible: btn.text !== ""
+                anchors.verticalCenter: parent.verticalCenter
+                text: btn.text
+                font.pointSize: Kirigami.Theme.defaultFont.pointSize - 1
+                color: Kirigami.Theme.textColor
+            }
+            Kirigami.Icon {
+                anchors.verticalCenter: parent.verticalCenter
+                width: Kirigami.Units.iconSizes.small
+                height: width
+                source: btn.iconName
+                opacity: 0.8
+            }
+        }
+
+        MouseArea {
+            id: btnMouse
+            anchors.fill: parent
+            hoverEnabled: true
+            onClicked: btn.clicked()
+        }
+    }
+}
diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/StartFooter.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/StartFooter.qml
new file mode 100644
index 0000000..c88cfc0
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/StartFooter.qml
@@ -0,0 +1,200 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Rodapé do Iniciar do Windows 11: conta (foto + nome) à esquerda;
+ *   à direita as pastas escolhidas ("Pastas ao lado do botão Liga/Desliga")
+ *   e o botão de energia, que abre Bloquear / Suspender / Desligar…
+ ***************************************************************************/
+
+import QtQuick
+import QtQuick.Layouts
+import Qt5Compat.GraphicalEffects
+
+import org.kde.plasma.plasmoid
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+import org.kde.coreaddons as KCoreAddons
+
+Rectangle {
+    id: footer
+
+    property var executable: null
+    readonly property Item powerButton: powerBtn
+
+    signal powerMenuRequested
+
+    implicitHeight: Math.round(Kirigami.Units.gridUnit * 3.4)
+    // faixa um pouco mais escura, separada por uma linha fina
+    color: Qt.rgba(0, 0, 0, 0.12)
+
+    Rectangle {
+        anchors.top: parent.top
+        width: parent.width
+        height: 1
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b, 0.08)
+    }
+
+    KCoreAddons.KUser { id: kuser }
+
+    readonly property var allFolders: ({
+        "settings":  { text: i18n("Settings"),  icon: "preferences-system",   command: "systemsettings" },
+        "explorer":  { text: i18n("File Explorer"), icon: "system-file-manager", command: "dolphin" },
+        "home":      { text: i18n("Home"),      icon: "user-home",             command: "xdg-open $HOME" },
+        "documents": { text: i18n("Documents"), icon: "folder-documents",      command: "xdg-open \"$(xdg-user-dir DOCUMENTS)\"" },
+        "downloads": { text: i18n("Downloads"), icon: "folder-download",       command: "xdg-open \"$(xdg-user-dir DOWNLOAD)\"" },
+        "music":     { text: i18n("Music"),     icon: "folder-music",          command: "xdg-open \"$(xdg-user-dir MUSIC)\"" },
+        "pictures":  { text: i18n("Pictures"),  icon: "folder-pictures",       command: "xdg-open \"$(xdg-user-dir PICTURES)\"" },
+        "videos":    { text: i18n("Videos"),    icon: "folder-videos",         command: "xdg-open \"$(xdg-user-dir VIDEOS)\"" },
+        "network":   { text: i18n("Network"),   icon: "folder-network",        command: "dolphin remote:/" }
+    })
+    readonly property var folders: {
+        var out = [];
+        var keys = Plasmoid.configuration.footerFolders || [];
+        for (var i = 0; i < keys.length; i++) {
+            if (allFolders[keys[i]]) out.push(allFolders[keys[i]]);
+        }
+        return out;
+    }
+
+    // ordem das pastas na lista "Personalizar", como em Iniciar > Pastas no Windows
+    readonly property var folderKeys: ["settings", "explorer", "documents", "downloads", "music",
+                                       "pictures", "videos", "network", "home"]
+
+    function openFolderMenu(item, x, y) {
+        var on = Plasmoid.configuration.footerFolders || [];
+        var acts = [];
+        for (var i = 0; i < folderKeys.length; i++) {
+            var k = folderKeys[i];
+            acts.push({ text: allFolders[k].text, icon: on.indexOf(k) >= 0 ? "checkmark" : "",
+                        actionId: "_start_footer_toggle", actionArgument: { key: k } });
+        }
+        var pos = item.mapToItem(sharedContextMenu, x, y);
+        // sem espaço embaixo, o menu de contexto já abre para cima
+        sharedContextMenu.open(acts, pos.x, pos.y, {});
+    }
+
+    // botão direito no espaço vazio do rodapé também personaliza as pastas
+    MouseArea {
+        anchors.fill: parent
+        acceptedButtons: Qt.RightButton
+        onClicked: mouse => footer.openFolderMenu(footer, mouse.x, mouse.y)
+    }
+
+    RowLayout {
+        anchors.fill: parent
+        anchors.leftMargin: Kirigami.Units.gridUnit * 2
+        anchors.rightMargin: Kirigami.Units.gridUnit * 2
+        spacing: Kirigami.Units.smallSpacing
+
+        // ── conta ─────────────────────────────────────────────────────────
+        FooterButton {
+            id: account
+            implicitWidth: accountRow.implicitWidth + Kirigami.Units.largeSpacing * 2
+            toolTip: ""
+            onClicked: footer.run("systemsettings kcm_users")
+
+            RowLayout {
+                id: accountRow
+                anchors.centerIn: parent
+                spacing: Kirigami.Units.largeSpacing
+
+                Item {
+                    Layout.preferredWidth: Kirigami.Units.iconSizes.medium
+                    Layout.preferredHeight: Kirigami.Units.iconSizes.medium
+                    Image {
+                        id: avatar
+                        anchors.fill: parent
+                        source: kuser.faceIconUrl.toString() !== "" ? kuser.faceIconUrl : ""
+                        visible: false
+                        cache: false
+                        fillMode: Image.PreserveAspectCrop
+                        sourceSize: Qt.size(width * 2, height * 2)
+                    }
+                    OpacityMask {
+                        anchors.fill: parent
+                        visible: avatar.status === Image.Ready
+                        source: avatar
+                        maskSource: Rectangle { width: avatar.width; height: avatar.height; radius: width / 2 }
+                    }
+                    Kirigami.Icon {
+                        anchors.fill: parent
+                        visible: avatar.status !== Image.Ready
+                        source: "user-identity"
+                    }
+                }
+                PlasmaComponents3.Label {
+                    text: kuser.fullName || kuser.loginName
+                    color: Kirigami.Theme.textColor
+                    elide: Text.ElideRight
+                    Layout.maximumWidth: Kirigami.Units.gridUnit * 14
+                }
+            }
+        }
+
+        Item { Layout.fillWidth: true }
+
+        // ── pastas + energia ─────────────────────────────────────────────
+        Repeater {
+            model: footer.folders
+            delegate: FooterButton {
+                required property var modelData
+                implicitWidth: implicitHeight
+                toolTip: modelData.text
+                onClicked: footer.run(modelData.command)
+                onRightClicked: (x, y) => footer.openFolderMenu(this, x, y)
+                Kirigami.Icon {
+                    anchors.centerIn: parent
+                    width: Kirigami.Units.iconSizes.smallMedium
+                    height: width
+                    source: modelData.icon
+                }
+            }
+        }
+
+        FooterButton {
+            id: powerBtn
+            implicitWidth: implicitHeight
+            toolTip: i18n("Power")
+            onClicked: footer.powerMenuRequested()
+            Kirigami.Icon {
+                anchors.centerIn: parent
+                width: Kirigami.Units.iconSizes.smallMedium
+                height: width
+                source: "system-shutdown"
+            }
+        }
+    }
+
+    function run(cmd) {
+        if (executable) executable.exec(cmd);
+        root.closeMenu();
+    }
+
+    component FooterButton: Rectangle {
+        id: fb
+        property string toolTip
+        signal clicked
+        signal rightClicked(real x, real y)
+        implicitHeight: Math.round(Kirigami.Units.gridUnit * 2.4)
+        Layout.preferredHeight: implicitHeight
+        Layout.preferredWidth: implicitWidth
+        radius: Kirigami.Units.smallSpacing
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g, Kirigami.Theme.textColor.b,
+                       fbMouse.pressed ? 0.05 : (fbMouse.containsMouse ? 0.08 : 0))
+        Behavior on color { ColorAnimation { duration: 90 } }
+        MouseArea {
+            id: fbMouse
+            anchors.fill: parent
+            hoverEnabled: true
+            z: 10
+            acceptedButtons: Qt.LeftButton | Qt.RightButton
+            onClicked: mouse => {
+                if (mouse.button === Qt.RightButton) fb.rightClicked(mouse.x, mouse.y);
+                else fb.clicked();
+            }
+            PlasmaComponents3.ToolTip.text: fb.toolTip
+            PlasmaComponents3.ToolTip.visible: fb.toolTip !== "" && containsMouse
+            PlasmaComponents3.ToolTip.delay: Kirigami.Units.toolTipDelay
+        }
+    }
+}

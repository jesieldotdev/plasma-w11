diff --git a/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/pages/HomePage.qml b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/pages/HomePage.qml
new file mode 100644
index 0000000..3a5417f
--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/pages/HomePage.qml
@@ -0,0 +1,486 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Página inicial do Iniciar do Windows 11 (versão 2025), numa só rolagem:
+ *
+ *     Fixado                              [Mostrar tudo >]
+ *     [■] [■] [■] [■] [■] [■]              grade de favoritos (6 colunas)
+ *
+ *     Mais usados                            apps mais abertos (2 linhas)
+ *     [■] [■] [■] [■] [■] [■]
+ *     Recentes                               arquivos recentes (2 linhas)
+ *
+ *     Todos                                   [Categoria v]
+ *     ┌──────┐ ┌──────┐ ┌──────┐ ┌──────┐   categorias (2x2 ícones),
+ *     │ ■  ■ │ │ ■  ■ │ │ ■  ■ │ │ ■  ■ │   grade ou lista A-Z
+ *     └──────┘ └──────┘ └──────┘ └──────┘
+ *
+ *   Clicar numa categoria abre a página dela (grade com os apps).
+ ***************************************************************************/
+
+import QtQuick
+import QtQuick.Layouts
+
+import org.kde.plasma.plasmoid
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+import org.kde.kitemmodels 1.0 as KItemModels
+import org.kde.plasma.private.kicker as Kicker
+
+import "../components"
+import "../code/theme.js" as Theme
+
+Item {
+    id: home
+
+    // modelos (definidos pelo MenuRepresentation em setModels)
+    property var favoritesModel: null
+    property var appsModel: null      // todos os apps, ordenados
+    property var appsRootModel: null  // rootModel do Kicker (categorias)
+
+    readonly property int columns: 6
+    readonly property real cellWidth: Math.floor(flick.width / columns)
+    readonly property real cellHeight: Math.round(Kirigami.Units.gridUnit * 4.6)
+    readonly property int pinnedRows: 3
+    readonly property int mostUsedRows: 2
+    readonly property int recentRows: 2
+    readonly property int categoryColumns: 4
+
+    // 0 = categorias, 1 = grade, 2 = lista (Plasmoid.configuration.allAppsViewMode)
+    readonly property int viewMode: Math.max(0, Math.min(2, Plasmoid.configuration.allAppsViewMode))
+    property bool pinnedExpanded: false
+
+    // categoria aberta: -1 = nenhuma (página inicial)
+    property int categoryRow: -1
+    property string categoryName: ""
+    property var categories: []
+
+    readonly property bool showingCategory: categoryRow >= 0
+
+    signal keyNavUpFromList
+
+    function rebuildCategories() {
+        var list = [];
+        var m = appsRootModel;
+        recentDocs.sourceModel = null;
+        if (m) {
+            // O Kicker põe "Aplicativos recentes" e "Arquivos recentes" antes de
+            // "Todos os aplicativos": os arquivos viram a seção Recomendado,
+            // como no Windows; nenhum dos dois é categoria.
+            var allRow = -1;
+            for (var r = 0; r < m.rowCount(); r++) {
+                var rm = m.modelForRow(r);
+                if (rm && rm.description === "KICKER_ALL_MODEL") { allRow = r; break; }
+            }
+            if (allRow > 0 && Plasmoid.configuration.showRecentDocs) {
+                recentDocs.sourceModel = m.modelForRow(allRow - 1);
+            }
+            for (var i = allRow + 1; i < m.rowCount(); i++) {
+                var sub = m.modelForRow(i);
+                if (!sub || sub.rowCount() === 0) continue;
+                var d = sub.description || "";
+                if (d.indexOf("KICKER_") === 0) continue;
+                var idx = m.index(i, 0);
+                var apps = [];
+                var n = sub.rowCount();
+                for (var j = 0; j < Math.min(n, 7); j++) {
+                    apps.push({ row: j, icon: sub.data(sub.index(j, 0), Qt.DecorationRole),
+                                name: sub.data(sub.index(j, 0), Qt.DisplayRole) });
+                }
+                list.push({ row: i, name: m.data(idx, Qt.DisplayRole), count: n, apps: apps, model: sub });
+            }
+        }
+        categories = list;
+    }
+
+    function openCategory(c) {
+        categoryModel.sourceModel = c.model;
+        categoryName = c.name;
+        categoryRow = c.row;
+        categoryGrid.currentIndex = -1;
+        flick.contentY = 0;
+        slideAnim.fromX = Kirigami.Units.gridUnit * 2;
+        slideAnim.restart();
+    }
+
+    function closeCategory() {
+        if (!showingCategory) return;
+        categoryRow = -1;
+        flick.contentY = 0;
+        slideAnim.fromX = -Kirigami.Units.gridUnit * 2;
+        slideAnim.restart();
+    }
+
+    function reset() {
+        categoryRow = -1;
+        pinnedExpanded = false;
+        flick.contentY = 0;
+        pinnedGrid.currentIndex = -1;
+        allGrid.currentIndex = -1;
+        allList.currentIndex = -1;
+        categoriesGrid.currentIndex = -1;
+    }
+
+    function setViewMode(mode) {
+        Plasmoid.configuration.allAppsViewMode = mode;
+        flick.contentY = 0;
+    }
+
+    // ── navegação por teclado ────────────────────────────────────────────
+    // As vistas, em ordem de cima para baixo.
+    readonly property var views: showingCategory ? [categoryGrid]
+        : [pinnedGrid, mostUsedGrid, recommendedGrid, viewMode === 0 ? categoriesGrid : (viewMode === 1 ? allGrid : allList)]
+
+    function focusView(i, fromBelow) {
+        var vs = views;
+        if (i < 0) {
+            keyNavUpFromList();
+            return;
+        }
+        if (i >= vs.length) return;
+        var v = vs[i];
+        if (v.count === 0) {
+            focusView(fromBelow ? i - 1 : i + 1, fromBelow);
+            return;
+        }
+        v.currentIndex = fromBelow ? v.count - 1 : 0;
+        v.forceActiveFocus();
+    }
+
+    function tryActivate() { focusView(0, false); }
+    function navigateDown() { focusView(0, false); }
+    function navigateUp() { focusView(views.length - 1, true); }
+
+    function activateCurrent() {
+        var vs = views;
+        for (var i = 0; i < vs.length; i++) {
+            if (vs[i].activeFocus && vs[i].currentItem) {
+                if (vs[i] === categoriesGrid) {
+                    openCategory(categories[vs[i].currentIndex]);
+                } else {
+                    vs[i].currentItem.launch();
+                }
+                return;
+            }
+        }
+        // nada selecionado: abre o primeiro fixado
+        if (!showingCategory && pinnedGrid.count > 0) {
+            favoritesModel.trigger(0, "", null);
+            root.closeMenu();
+        }
+    }
+
+    // Comportamento comum das vistas: setas saem para a vista vizinha nas
+    // bordas e a rolagem acompanha o item selecionado.
+    function handleEdgeKeys(view, event, cols) {
+        var i = views.indexOf(view);
+        if (event.key === Qt.Key_Down && view.currentIndex + cols >= view.count) {
+            event.accepted = true;
+            focusView(i + 1, false);
+        } else if (event.key === Qt.Key_Up && view.currentIndex - cols < 0) {
+            event.accepted = true;
+            focusView(i - 1, true);
+        }
+    }
+
+    function ensureVisible(item) {
+        if (!item) return;
+        var p = item.mapToItem(flickContent, 0, 0);
+        var margin = Kirigami.Units.largeSpacing;
+        if (p.y - margin < flick.contentY) {
+            flick.contentY = Math.max(0, p.y - margin);
+        } else if (p.y + item.height + margin > flick.contentY + flick.height) {
+            flick.contentY = Math.min(flick.contentHeight - flick.height, p.y + item.height + margin - flick.height);
+        }
+    }
+
+    // Mais usados: os apps abertos mais vezes (o KDE conta pelo histórico de uso)
+    Kicker.RecentUsageModel {
+        id: mostUsedSource
+        shownItems: Kicker.RecentUsageModel.OnlyApps
+        ordering: Kicker.RecentUsageModel.Popular
+    }
+    KItemModels.KSortFilterProxyModel {
+        id: mostUsed
+        sourceModel: Plasmoid.configuration.showMostUsed ? mostUsedSource : null
+        filterRowCallback: (row, parent) => row < home.columns * home.mostUsedRows
+        function trigger(row, actionId, argument) {
+            var src = mapToSource(index(row, 0));
+            return src.valid && sourceModel ? sourceModel.trigger(src.row, actionId, argument) : false;
+        }
+    }
+
+    // Recentes: os arquivos abertos por último (2 linhas)
+    KItemModels.KSortFilterProxyModel {
+        id: recentDocs
+        filterRowCallback: (row, parent) => row < 2 * home.recentRows
+        function trigger(row, actionId, argument) {
+            var src = mapToSource(index(row, 0));
+            return src.valid && sourceModel ? sourceModel.trigger(src.row, actionId, argument) : false;
+        }
+    }
+
+    KItemModels.KSortFilterProxyModel {
+        id: categoryModel
+        sortRoleName: "display"
+        sortOrder: Qt.AscendingOrder
+        function trigger(row, actionId, argument) {
+            var src = mapToSource(index(row, 0));
+            return src.valid && sourceModel ? sourceModel.trigger(src.row, actionId, argument) : false;
+        }
+    }
+
+    ParallelAnimation {
+        id: slideAnim
+        property real fromX: 0
+        NumberAnimation { target: contentShift; property: "x"; from: slideAnim.fromX; to: 0; duration: 200; easing.type: Easing.OutCubic }
+        NumberAnimation { target: flickContent; property: "opacity"; from: 0; to: 1; duration: 160; easing.type: Easing.OutQuad }
+    }
+
+    Flickable {
+        id: flick
+        anchors.fill: parent
+        clip: true
+        contentWidth: width
+        contentHeight: flickContent.implicitHeight
+        boundsBehavior: Flickable.StopAtBounds
+        Behavior on contentY { enabled: !flick.moving; NumberAnimation { duration: 120; easing.type: Easing.OutCubic } }
+
+        PlasmaComponents3.ScrollBar.vertical: PlasmaComponents3.ScrollBar {
+            policy: PlasmaComponents3.ScrollBar.AsNeeded
+        }
+
+        ColumnLayout {
+            id: flickContent
+            width: flick.width
+            spacing: Kirigami.Units.smallSpacing
+            transform: Translate { id: contentShift }
+
+            // ══ Página inicial ══════════════════════════════════════════
+            SectionHeader {
+                visible: !home.showingCategory
+                title: i18n("Pinned")
+                buttonText: pinnedGrid.count > home.columns * home.pinnedRows
+                            ? (home.pinnedExpanded ? i18n("Show less") : i18n("Show all")) : ""
+                buttonIcon: home.pinnedExpanded ? "go-up" : "go-next"
+                onButtonClicked: home.pinnedExpanded = !home.pinnedExpanded
+            }
+
+            GridView {
+                id: pinnedGrid
+                visible: !home.showingCategory
+                Layout.fillWidth: true
+                readonly property int rows: Math.ceil(count / home.columns)
+                Layout.preferredHeight: Math.max(1, home.pinnedExpanded ? rows : Math.min(rows, home.pinnedRows)) * cellHeight
+                cellWidth: home.cellWidth
+                cellHeight: home.cellHeight
+                interactive: false
+                clip: true
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: home.favoritesModel
+                delegate: AppTile {}
+                Behavior on Layout.preferredHeight { NumberAnimation { duration: 160; easing.type: Easing.OutCubic } }
+
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => {
+                    // a parte escondida (além das linhas visíveis) abre ao descer até ela
+                    if (event.key === Qt.Key_Down && !home.pinnedExpanded
+                            && currentIndex + home.columns >= home.columns * home.pinnedRows
+                            && currentIndex + home.columns < count) {
+                        home.pinnedExpanded = true;
+                    }
+                    home.handleEdgeKeys(pinnedGrid, event, home.columns);
+                }
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            Text {
+                visible: !home.showingCategory && pinnedGrid.count === 0
+                Layout.fillWidth: true
+                Layout.preferredHeight: home.cellHeight
+                horizontalAlignment: Text.AlignHCenter
+                verticalAlignment: Text.AlignVCenter
+                color: Kirigami.Theme.disabledTextColor
+                font: Kirigami.Theme.defaultFont
+                wrapMode: Text.Wrap
+                text: i18n("Right-click an app and choose \"Add to Favorites\" to pin it here.")
+            }
+
+            SectionHeader {
+                visible: !home.showingCategory && mostUsedGrid.count > 0
+                Layout.topMargin: Kirigami.Units.largeSpacing
+                title: i18n("Most used")
+            }
+
+            GridView {
+                id: mostUsedGrid
+                visible: !home.showingCategory && count > 0
+                Layout.fillWidth: true
+                Layout.preferredHeight: Math.ceil(count / home.columns) * cellHeight
+                cellWidth: home.cellWidth
+                cellHeight: home.cellHeight
+                interactive: false
+                clip: true
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: mostUsed
+                delegate: AppTile {}
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => home.handleEdgeKeys(mostUsedGrid, event, home.columns)
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            SectionHeader {
+                visible: !home.showingCategory && recommendedGrid.count > 0
+                Layout.topMargin: Kirigami.Units.largeSpacing
+                title: i18n("Recent")
+            }
+
+            GridView {
+                id: recommendedGrid
+                visible: !home.showingCategory && count > 0
+                Layout.fillWidth: true
+                Layout.preferredHeight: Math.ceil(count / 2) * cellHeight
+                cellWidth: Math.floor(width / 2)
+                cellHeight: Math.round(Kirigami.Units.gridUnit * 3.2)
+                interactive: false
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: recentDocs
+                delegate: RecommendedItem {}
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => home.handleEdgeKeys(recommendedGrid, event, 2)
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            SectionHeader {
+                visible: !home.showingCategory
+                Layout.topMargin: Kirigami.Units.largeSpacing
+                title: i18nc("@title start menu section with every application", "All")
+                buttonText: [i18n("Category"), i18n("Grid"), i18n("List")][home.viewMode]
+                buttonIcon: "go-down"
+                onButtonClicked: button => {
+                    var acts = [];
+                    var labels = [i18n("Category"), i18n("Grid"), i18n("List")];
+                    var icons = ["view-group", "view-grid", "view-list-details"];
+                    for (var i = 0; i < 3; i++) {
+                        acts.push({ text: labels[i], icon: home.viewMode === i ? "checkmark" : icons[i],
+                                    actionId: "_start_view_mode", actionArgument: { mode: i } });
+                    }
+                    var pos = button.mapToItem(sharedContextMenu, 0, button.height);
+                    sharedContextMenu.open(acts, pos.x, pos.y, {});
+                }
+            }
+
+            // ── Todos: categorias ──────────────────────────────────────────
+            GridView {
+                id: categoriesGrid
+                visible: !home.showingCategory && home.viewMode === 0
+                Layout.fillWidth: true
+                Layout.preferredHeight: Math.ceil(count / home.categoryColumns) * cellHeight
+                cellWidth: Math.floor(width / home.categoryColumns)
+                cellHeight: Math.round(cellWidth * 0.72) + Kirigami.Units.gridUnit * 1.8
+                interactive: false
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: home.categories
+                delegate: CategoryTile {
+                    onOpenRequested: home.openCategory(modelData)
+                }
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => {
+                    if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {
+                        event.accepted = true;
+                        if (currentIndex >= 0) home.openCategory(home.categories[currentIndex]);
+                        return;
+                    }
+                    home.handleEdgeKeys(categoriesGrid, event, home.categoryColumns);
+                }
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            // ── Todos: grade A-Z ────────────────────────────────────────────
+            GridView {
+                id: allGrid
+                visible: !home.showingCategory && home.viewMode === 1
+                Layout.fillWidth: true
+                Layout.preferredHeight: Math.ceil(count / home.columns) * cellHeight
+                cellWidth: home.cellWidth
+                cellHeight: home.cellHeight
+                interactive: false
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: visible ? home.appsModel : null
+                delegate: AppTile {}
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => home.handleEdgeKeys(allGrid, event, home.columns)
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            // ── Todos: lista A-Z com as letras ──────────────────────────────
+            ListView {
+                id: allList
+                visible: !home.showingCategory && home.viewMode === 2
+                Layout.fillWidth: true
+                Layout.preferredHeight: contentHeight
+                interactive: false
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: visible ? home.appsModel : null
+                section.property: "display"
+                section.criteria: ViewSection.FirstCharacter
+                section.delegate: PlasmaComponents3.Label {
+                    required property string section
+                    width: ListView.view.width
+                    height: Math.round(Kirigami.Units.gridUnit * 1.8)
+                    leftPadding: Kirigami.Units.largeSpacing
+                    verticalAlignment: Text.AlignVCenter
+                    font.weight: Font.DemiBold
+                    color: Kirigami.Theme.textColor
+                    text: section.toUpperCase()
+                }
+                delegate: ListItemDelegate {
+                    iconSize: Kirigami.Units.iconSizes.smallMedium
+                }
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => home.handleEdgeKeys(allList, event, 1)
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            // ══ Página de uma categoria ═════════════════════════════════
+            SectionHeader {
+                visible: home.showingCategory
+                title: home.categoryName
+                backButton: true
+                onBackClicked: home.closeCategory()
+            }
+
+            GridView {
+                id: categoryGrid
+                visible: home.showingCategory
+                Layout.fillWidth: true
+                Layout.preferredHeight: Math.ceil(count / home.columns) * cellHeight
+                cellWidth: home.cellWidth
+                cellHeight: home.cellHeight
+                interactive: false
+                currentIndex: -1
+                highlightFollowsCurrentItem: false
+                model: categoryModel
+                delegate: AppTile {}
+                Keys.priority: Keys.BeforeItem
+                Keys.onPressed: event => home.handleEdgeKeys(categoryGrid, event, home.columns)
+                onCurrentItemChanged: if (activeFocus) home.ensureVisible(currentItem)
+                onActiveFocusChanged: if (!activeFocus) currentIndex = -1
+            }
+
+            Item { Layout.preferredHeight: Kirigami.Units.largeSpacing }
+        }
+    }
+}

--- /dev/null
+++ b/plasma/applets/org.kde.windowsmodern.startmenu/contents/ui/components/AppTile.qml
@@ -0,0 +1,125 @@
+/***************************************************************************
+ *   License: GPL-3.0-or-later
+ *
+ *   Bloco de app do Iniciar do Windows 11 (Fixado e grade de "Todos"):
+ *   ícone em cima, nome embaixo (até duas linhas), fundo arredondado no
+ *   hover.  Clique abre, botão direito abre o menu de contexto compartilhado.
+ *   Funciona em qualquer GridView cujo model tenha trigger(row, id, arg).
+ ***************************************************************************/
+
+import QtQuick
+
+import org.kde.plasma.components as PlasmaComponents3
+import org.kde.kirigami as Kirigami
+
+import "../code/tools.js" as Tools
+import "../code/theme.js" as Theme
+
+Item {
+    id: tile
+
+    width: GridView.view ? GridView.view.cellWidth : Kirigami.Units.gridUnit * 5
+    height: GridView.view ? GridView.view.cellHeight : Kirigami.Units.gridUnit * 5
+
+    enabled: !model.disabled
+
+    property int itemIndex: model.index
+    property int iconSize: Kirigami.Units.iconSizes.medium
+
+    Accessible.role: Accessible.MenuItem
+    Accessible.name: label.text
+
+    Rectangle {
+        anchors.fill: parent
+        anchors.margins: Kirigami.Units.smallSpacing / 2
+        radius: Kirigami.Units.smallSpacing
+        color: Qt.rgba(Kirigami.Theme.textColor.r, Kirigami.Theme.textColor.g,
+                       Kirigami.Theme.textColor.b, mouseArea.pressed ? 0.04 : 0.07)
+        border.width: tile.GridView.isCurrentItem && tile.GridView.view.activeFocus ? 2 : 0
+        border.color: Kirigami.Theme.textColor
+        opacity: mouseArea.containsMouse || (tile.GridView.isCurrentItem && tile.GridView.view.activeFocus) ? 1 : 0
+        Behavior on opacity { NumberAnimation { duration: 90 } }
+    }
+
+    Kirigami.Icon {
+        id: icon
+        anchors.horizontalCenter: parent.horizontalCenter
+        anchors.top: parent.top
+        anchors.topMargin: Math.round((parent.height - tile.iconSize - label.height - Kirigami.Units.smallSpacing * 2) / 2)
+        width: tile.iconSize
+        height: width
+        animated: false
+        source: model.decoration !== undefined ? model.decoration : ""
+        // o Windows "aperta" o ícone um pouco ao clicar
+        scale: mouseArea.pressed ? 0.88 : 1
+        Behavior on scale { NumberAnimation { duration: 90 } }
+    }
+
+    PlasmaComponents3.Label {
+        id: label
+        anchors.top: icon.bottom
+        anchors.topMargin: Kirigami.Units.smallSpacing * 2
+        anchors.left: parent.left
+        anchors.right: parent.right
+        anchors.leftMargin: Kirigami.Units.smallSpacing
+        anchors.rightMargin: Kirigami.Units.smallSpacing
+        horizontalAlignment: Text.AlignHCenter
+        wrapMode: Text.Wrap
+        maximumLineCount: 2
+        elide: Text.ElideRight
+        font.pointSize: Kirigami.Theme.defaultFont.pointSize - 1
+        color: Kirigami.Theme.textColor
+        textFormat: Text.PlainText
+        text: ("name" in model ? model.name : (model.display !== undefined ? model.display : ""))
+    }
+
+    MouseArea {
+        id: mouseArea
+        anchors.fill: parent
+        hoverEnabled: true
+        acceptedButtons: Qt.LeftButton | Qt.RightButton
+        onClicked: mouse => {
+            if (mouse.button === Qt.RightButton) {
+                tile.openContextMenu(mouse.x, mouse.y);
+            } else {
+                tile.launch();
+            }
+        }
+    }
+
+    function launch() {
+        var view = tile.GridView.view;
+        if (view && view.model && typeof view.model.trigger === "function") {
+            view.model.trigger(tile.itemIndex, "", null);
+            root.closeMenu();
+        }
+    }
+
+    function openContextMenu(localX, localY) {
+        var favModel = (typeof kicker !== "undefined" && kicker.globalFavorites) ? kicker.globalFavorites : null;
+        var favId = model.favoriteId !== undefined ? model.favoriteId : "";
+        var url = model.url !== undefined ? model.url : "";
+        var actionList = model.actionList !== undefined ? model.actionList : null;
+        var acts = Tools.buildAppActions(i18n, favModel, favId, url, actionList);
+        var view = tile.GridView.view;
+        // Fixado: "Mover para o início", como no Windows
+        if (view && view.model === favModel && tile.itemIndex > 0) {
+            if (acts.length > 0) acts.push({ "type": "separator" });
+            acts.push({ text: i18n("Move to front"), icon: "go-first", actionId: "_start_move_front",
+                        actionArgument: { index: tile.itemIndex } });
+        }
+        if (acts.length === 0) return;
+        var pos = tile.mapToItem(sharedContextMenu, localX, localY);
+        sharedContextMenu.open(acts, pos.x, pos.y, { model: view ? view.model : null, index: tile.itemIndex });
+    }
+
+    Keys.onPressed: event => {
+        if (event.key === Qt.Key_Enter || event.key === Qt.Key_Return) {
+            event.accepted = true;
+            launch();
+        } else if (event.key === Qt.Key_Menu) {
+            event.accepted = true;
+            openContextMenu(width / 2, height / 2);
+        }
+    }
+}

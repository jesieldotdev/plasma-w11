+/*
+ * Página "Este Computador" no estilo do Windows 11 (plasma-w11): mostrada no
+ * lugar da lista de arquivos em thispc:/, com os grupos "Pastas" e
+ * "Dispositivos e unidades" em blocos (ícone à esquerda; nas unidades, nome,
+ * barra de espaço e "X GB livre(s) de Y GB").
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef THISPCPAGE_H
+#define THISPCPAGE_H
+
+#include <QScrollArea>
+#include <QUrl>
+
+class QGridLayout;
+class QLabel;
+class QToolButton;
+
+class ThisPcPage : public QScrollArea
+{
+    Q_OBJECT
+
+public:
+    explicit ThisPcPage(QWidget *parent = nullptr);
+
+    /** Relê pastas e unidades (espaço livre atualizado). */
+    void refresh();
+
+Q_SIGNALS:
+    void urlActivated(const QUrl &url);
+    void urlInNewTab(const QUrl &url);
+
+protected:
+    void resizeEvent(QResizeEvent *event) override;
+    void showEvent(QShowEvent *event) override;
+
+private:
+    struct Section {
+        QToolButton *header = nullptr;
+        QWidget *body = nullptr;
+        QGridLayout *grid = nullptr;
+        QList<QWidget *> tiles;
+    };
+    void setupSection(Section &section, QWidget *content);
+    void layoutSection(Section &section, int tileWidth);
+    void relayout();
+    void clearSelection(QWidget *except);
+
+    Section m_folders;
+    Section m_drives;
+    int m_columns = 0;
+};
+
+#endif

+/*
+ * Painel de navegação no estilo do Explorador do Windows 11 (plasma-w11):
+ * uma árvore só com "Acesso rápido" (pastas fixadas), "Este Computador"
+ * (pastas do usuário e unidades, cada uma expandindo as subpastas),
+ * unidades removíveis e "Rede".
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef NAVIGATIONPANEL_H
+#define NAVIGATIONPANEL_H
+
+#include "panels/panel.h"
+
+class KFilePlacesModel;
+class QStandardItem;
+class QStandardItemModel;
+class QTreeView;
+class QTimer;
+
+class NavigationPanel : public Panel
+{
+    Q_OBJECT
+
+public:
+    explicit NavigationPanel(QWidget *parent = nullptr);
+    ~NavigationPanel() override;
+
+Q_SIGNALS:
+    void folderActivated(const QUrl &url);
+    void folderInNewTab(const QUrl &url);
+    void folderInNewActiveTab(const QUrl &url);
+
+protected:
+    bool urlChanged() override;
+    void showEvent(QShowEvent *event) override;
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+private:
+    void build();
+    void rebuildQuickAccess();
+    void rebuildThisPc();
+    QStandardItem *folderItem(const QString &name, const QString &icon, const QString &path, bool pinned = false);
+    void loadChildren(QStandardItem *item);
+    void selectUrl(const QUrl &url);
+    void activate(const QModelIndex &index, bool newTab);
+    void showContextMenu(const QPoint &pos);
+    int pinnedRow(const QUrl &url) const;
+
+    QTreeView *m_view = nullptr;
+    QStandardItemModel *m_model = nullptr;
+    KFilePlacesModel *m_places = nullptr;
+    QStandardItem *m_quickAccess = nullptr;
+    QStandardItem *m_thisPc = nullptr;
+    QStandardItem *m_network = nullptr;
+    QList<QStandardItem *> m_removable;
+    QTimer *m_rebuildTimer = nullptr;
+    bool m_selecting = false;
+};
+
+#endif
